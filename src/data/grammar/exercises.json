    {"q": "Ich lerne Deutsch, denn ___.", "options": ["ich arbeite in Berlin", "ich in Berlin arbeite", "arbeite ich in Berlin"], "answer": "ich arbeite in Berlin", "en": "I'm learning German because I work in Berlin.", "why": {"de": "denn → normale Wortstellung (Verb auf 2).", "en": "denn → normal word order (verb in position 2)."}},
    {"q": "Es regnet, deshalb ___.", "options": ["nehme ich einen Schirm", "ich nehme einen Schirm", "ich einen Schirm nehme"], "answer": "nehme ich einen Schirm", "en": "It's raining, so I'm taking an umbrella.", "why": {"de": "deshalb steht auf Position 1 → Verb direkt danach.", "en": "deshalb takes position 1 → the verb comes right after."}},
